# Contoh konfigurasi server katalog PWK.
# Salin ke <PWK_DATA_DIR>/env (default: /data/workspace/pwk-data/env) dengan mode 600.
# Server membaca file itu saat start, bukan .env di root repo.

# ---------- jaringan ----------
# Hanya listen di localhost; trafik publik masuk lewat tunnel cloudflared.
PWK_HOST=127.0.0.1
PWK_PORT=8098

# ---------- lokasi berkas ----------
PWK_DATA_DIR=/data/workspace/pwk-data
# PWK_DB=/data/workspace/pwk-data/pwk.db
PWK_STATIC=/data/workspace/PWK/dist
PWK_FALLBACK=/data/workspace/PWK/public/data/katalog.json

# ---------- jadwal ----------
# 0 = hanya lewat POST /api/cron/discover (cron-job.org)
PWK_AUTORUN_MINUTES=10
MAX_ITEMS_PER_RUN=12
STEP_BUDGET_MS=210000

# ---------- pipeline & LLM ----------
DISCOVERY_ENABLED=1
DISCOVERY_LLM_URL=https://doomps.web.id/v1/chat/completions
DISCOVERY_LLM_MODEL=fp/deepseek-v4.1-flash
DISCOVERY_VISION_MODEL=hmti-v1.0

# ---------- rahasia (JANGAN diisi di repo) ----------
# Bearer untuk POST /api/cron/discover; dikirim cron-job.org.
CRON_SECRET=
# Bearer untuk /api/admin/review dan /api/admin/refresh.
ADMIN_TOKEN=
# Kunci API gateway LLM.
DISCOVERY_LLM_KEY=
